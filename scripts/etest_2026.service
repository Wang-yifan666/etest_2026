[Unit]
Description=etest_2026 competition control program
After=multi-user.target

# 比赛程序异常退出后持续尝试拉起
StartLimitIntervalSec=0

[Service]
Type=simple
User=REPLACE_WITH_USER
WorkingDirectory=REPLACE_WITH_WORKDIR
ExecStart=REPLACE_WITH_EXECUTABLE --config-dir REPLACE_WITH_CONFIGDIR

Restart=on-failure
RestartSec=2

KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target