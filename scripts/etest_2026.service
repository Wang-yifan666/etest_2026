[Unit]
Description=etest_2026 competition control program
After=multi-user.target

[Service]
Type=simple
User=REPLACE_WITH_USER
WorkingDirectory=REPLACE_WITH_WORKDIR
ExecStart=REPLACE_WITH_EXECUTABLE --config-dir REPLACE_WITH_CONFIGDIR
Restart=on-failure
RestartSec=1
StartLimitIntervalSec=60
StartLimitBurst=5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target